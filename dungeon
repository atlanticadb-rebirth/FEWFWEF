local State = {
    AutoTrain      = false,
    AutoRebirth    = false,
    AutoCollectOre = false,
    SelectedOre    = nil,   -- contoh: "Ore_1"
    TrainArgs      = {11},  -- sesuaikan kalau perlu
}

-- =========================================================
-- HELPER: Ambil daftar ore di OreCache
-- =========================================================
local function getOreList()
    local OreCache = Workspace:FindFirstChild("OreCache")
    if not OreCache then return {} end

    local list = {}
    for _, child in ipairs(OreCache:GetChildren()) do
        if child.Name:match("^Ore_%d+$") then
            table.insert(list, child.Name)
        end
    end
    table.sort(list, function(a, b)
        local na = tonumber(a:match("%d+")) or 0
        local nb = tonumber(b:match("%d+")) or 0
        return na < nb
    end)
    return list
end

-- =========================================================
-- HELPER: Trigger ProximityPrompt ore terpilih
-- =========================================================
local function collectSelectedOre()
    local OreCache = Workspace:FindFirstChild("OreCache")
    if not OreCache then return end
    if not State.SelectedOre then return end

    local ore = OreCache:FindFirstChild(State.SelectedOre)
    if not ore then return end

    local main = ore:FindFirstChild("MAIN")
    if not main then return end

    local prompt = main:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then return end

    -- Trigger via fireproximityprompt (biasanya tersedia di executor)
    if fireproximityprompt then
        fireproximityprompt(prompt)
    else
        -- Fallback: pakai FireServer langsung (kalau prompt punya remote sendiri)
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end
end

-- =========================================================
-- LOOPS
-- =========================================================
task.spawn(function()
    while true do
        task.wait(0.1)
        if State.AutoTrain and IntoAutoTrain then
            pcall(function()
                IntoAutoTrain:FireServer(unpack(State.TrainArgs))
            end)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        if State.AutoRebirth and TryRebirthRE then
            pcall(function()
                TryRebirthRE:FireServer()
            end)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.15)
        if State.AutoCollectOre then
            pcall(collectSelectedOre)
        end
    end
end)
-- Simpan referensi
local OreDropdown

-- Fungsi update dropdown
local function updateOreDropdown()
    local list = getOreList()
    print("[Ore] Update list:", table.concat(list, ", "))

    if OreDropdown and #list > 0 then
        -- coba beberapa method (beda versi WindUI beda API)
        if OreDropdown.Refresh then
            pcall(function() OreDropdown:Refresh(list) end)
        elseif OreDropdown.SetValues then
            pcall(function() OreDropdown:SetValues(list) end)
        elseif OreDropdown.Values then
            OreDropdown.Values = list
        end
    end
end
