FOV_Circle.Transparency   = 1

local SkeletonConnections = {
    { "Head",       "UpperTorso" }, { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
}

local function CreateDrawing(dtype, props)
    local d = Drawing.new(dtype)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function IsTeammate(player)
    if not getgenv().Settings.TeamCheck then return false end
    return player.Team ~= nil and player.Team == LocalPlayer.Team
end

local function AddESP(player)
    if ESP_Cache[player] then return end
    local Objects = {
        Box              = CreateDrawing("Square", { Thickness = 1.5, Transparency = 1, Filled = false, Visible = false }),
        Name             = CreateDrawing("Text",
            { Size = 14, Center = true, Outline = true, Visible = false, Color = Color3.new(1, 1, 1) }),
        HealthBarOutline = CreateDrawing("Square",
            { Thickness = 1, Filled = true, Color = Color3.new(0, 0, 0), Transparency = 1, Visible = false }),
        HealthBar        = CreateDrawing("Square", { Thickness = 1, Filled = true, Visible = false }),
        Arrow            = CreateDrawing("Triangle", {
            Thickness = 1,
            Filled = true,
            Visible = false,
            Color = Color3.new(
                1, 0, 0)
        }),
        Line             = CreateDrawing("Line",
            { Thickness = 1, Color = getgenv().Settings.LinesColor, Visible = false }),
        Skeleton         = {},
    }
    for i = 1, #SkeletonConnections do
        table.insert(Objects.Skeleton,
            CreateDrawing("Line", { Thickness = 1, Color = getgenv().Settings.SkeletonColor, Visible = false }))
    end
    ESP_Cache[player] = Objects
end

local function RemoveESP(player)
    if ESP_Cache[player] then
        local o = ESP_Cache[player]
        o.Box:Remove(); o.Name:Remove(); o.HealthBar:Remove(); o.HealthBarOutline:Remove(); o.Arrow:Remove(); o.Line
            :Remove()
        for _, line in pairs(o.Skeleton) do line:Remove() end
        ESP_Cache[player] = nil
    end
    if Chams_Cache[player] then
        Chams_Cache[player]:Destroy()
        Chams_Cache[player] = nil
    end
end

local function UpdateChams(player)
    if not player.Character then return end
    if getgenv().Settings.ESP_Enabled and getgenv().Settings.Chams and not IsTeammate(player) then
        local hum = player.Character:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then
            if not Chams_Cache[player] or not Chams_Cache[player].Parent then
                local hl               = Instance.new("Highlight")
                hl.Name                = "ESPHighlight"
                hl.FillColor           = getgenv().Settings.ChamsColor
                hl.OutlineColor        = getgenv().Settings.ChamsOutline
                hl.FillTransparency    = 0.5
                hl.OutlineTransparency = 0
                hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Adornee             = player.Character
                hl.Parent              = player.Character
                Chams_Cache[player]    = hl
            end
            return
        end
    end
    if Chams_Cache[player] then
        Chams_Cache[player]:Destroy(); Chams_Cache[player] = nil
    end
end

RunService:BindToRenderStep("Generous_ESP", 200, function()
    -- Pengaman jika nilai FOV / Aimbot tidak di-set dari script aimbot-mu
    FOV_Circle.Position = UserInputService:GetMouseLocation()
    FOV_Circle.Radius   = getgenv().Settings.FOV or 60
    FOV_Circle.Visible  = (getgenv().Settings.ShowFOV and getgenv().Settings.Aimbot) or false

    for player, drawings in pairs(ESP_Cache) do
        if player == LocalPlayer then continue end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChild("Humanoid")

        -- Update Chams di luar screening OnScreen agar musuh di balik tembok tetap terlihat warna solidnya
        UpdateChams(player)

        if getgenv().Settings.ESP_Enabled and char and root and hum and hum.Health > 0 and not IsTeammate(player) then
            local vector, onScreen = camera:WorldToViewportPoint(root.Position)

            if onScreen then
                local BoxSize = Vector2.new(2000 / vector.Z, 2500 / vector.Z)
                local BoxPos  = Vector2.new(vector.X - BoxSize.X / 2, vector.Y - BoxSize.Y / 2)

                -- 1. BOX ESP
                if getgenv().Settings.Box then
                    drawings.Box.Size = BoxSize; drawings.Box.Position = BoxPos
                    drawings.Box.Visible = true; drawings.Box.Color = getgenv().Settings.BoxColor
                else
                    drawings.Box.Visible = false
                end

                -- 2. NAME ESP
                if getgenv().Settings.Name then
                    drawings.Name.Text     = string.format("%s [%dm]", player.Name,
                        math.floor((camera.CFrame.Position - root.Position).Magnitude))
                    drawings.Name.Position = Vector2.new(vector.X, BoxPos.Y - 18)
                    drawings.Name.Visible  = true
                else
                    drawings.Name.Visible = false
                end

                -- 3. HEALTHBAR ESP
                if getgenv().Settings.HealthBar then
                    local hp                           = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    drawings.HealthBarOutline.Size     = Vector2.new(4, BoxSize.Y + 2)
                    drawings.HealthBarOutline.Position = Vector2.new(BoxPos.X - 6, BoxPos.Y - 1)

                    drawings.HealthBar.Size            = Vector2.new(2, BoxSize.Y * hp)
                    drawings.HealthBar.Position        = Vector2.new(BoxPos.X - 5,
                        BoxPos.Y + (BoxSize.Y - BoxSize.Y * hp))
                    drawings.HealthBar.Color           = Color3.fromHSV(hp * 0.3, 1, 1)

                    drawings.HealthBar.Visible         = true
                    drawings.HealthBarOutline.Visible  = true
                else
                    drawings.HealthBar.Visible = false
                    drawings.HealthBarOutline.Visible = false
                end

                -- 4. SNAP LINES (Garis bawah layar menuju musuh)
                if getgenv().Settings.Lines then
                    drawings.Line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                    drawings.Line.To = Vector2.new(vector.X, vector.Y)
                    drawings.Line.Color = getgenv().Settings.LinesColor
                    drawings.Line.Visible = true
                else
                    drawings.Line.Visible = false
                end

                -- 5. SKELETON ESP (Sistem Render Sambungan Tulang R15/R6)
                if getgenv().Settings.Skeleton then
                    for idx, connection in ipairs(SkeletonConnections) do
                        local part1 = char:FindFirstChild(connection[1])
                        local part2 = char:FindFirstChild(connection[2])
                        local line  = drawings.Skeleton[idx]

                        if part1 and part2 and line then
                            local v1, os1 = camera:WorldToViewportPoint(part1.Position)
                            local v2, os2 = camera:WorldToViewportPoint(part2.Position)

                            if os1 and os2 then
                                line.From = Vector2.new(v1.X, v1.Y)
                                line.To = Vector2.new(v2.X, v2.Y)
                                line.Color = getgenv().Settings.SkeletonColor
                                line.Visible = true
                            else
                                line.Visible = false
                            end
                        elseif line then
                            line.Visible = false
                        end
                    end
                else
                    for _, line in pairs(drawings.Skeleton) do line.Visible = false end
                end

                drawings.Arrow.Visible = false
            elseif getgenv().Settings.Offscreen then
                drawings.Arrow.Visible = true
                -- Sembunyikan gambar 2D jika di luar layar
                drawings.Box.Visible = false; drawings.Name.Visible = false
                drawings.HealthBar.Visible = false; drawings.HealthBarOutline.Visible = false; drawings.Line.Visible = false
                for _, line in pairs(drawings.Skeleton) do line.Visible = false end
            else
                drawings.Box.Visible = false; drawings.Name.Visible = false
                drawings.HealthBar.Visible = false; drawings.HealthBarOutline.Visible = false
                drawings.Arrow.Visible = false; drawings.Line.Visible = false
                for _, line in pairs(drawings.Skeleton) do line.Visible = false end
            end
        else
            -- Nonaktifkan semua jika ESP mati atau target mati / satu tim
            for _, d in pairs(drawings) do
                if type(d) == "table" then
                    for _, l in pairs(d) do l.Visible = false end
                else
                    d.Visible = false
                end
            end
        end
    end
end)

