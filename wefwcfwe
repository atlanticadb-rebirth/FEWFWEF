-- // Helper: Baca Text/Value Luck dari RenderedEggs
local function getEggLuck(eggModel)
    if not eggModel then return "???" end
    local handle = eggModel:FindFirstChild("Handle")

    if handle then
        local eggLuck = handle:FindFirstChild("EggLuck")
        if eggLuck then
            local luckObj = eggLuck:FindFirstChild("Luck")
            if luckObj then
                if luckObj:IsA("TextLabel") or luckObj:IsA("TextBox") then
                    return luckObj.Text
                elseif luckObj:IsA("StringValue") or luckObj:IsA("NumberValue") or luckObj:IsA("IntValue") then
                    return tostring(luckObj.Value)
                end
            end
        end
    end
    return "???"
end

-- // Helper: Cek Tier OP (M, B, T)
local function isHighTier(luckStr)
    local s = tostring(luckStr):upper()
    local lastChar = s:sub(-1)
    return lastChar == "M" or lastChar == "B" or lastChar == "T"
end

-- // Helper: Cari Plot Player
function utility:GetMyPlot()
    if not Plots then return nil end
    for _, plot in ipairs(Plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        if data then
            local owner = data:FindFirstChild("Owner")
            if owner and (owner.Value == LocalPlayer.Name or owner.Value == LocalPlayer or owner.Value == tostring(LocalPlayer.UserId)) then
                return plot
            end
        end
    end
    return nil
end

-- // Helper: Scan Telur dari ActiveEggs & RenderedEggs
function utility:RefreshEggLists()
    local opList = {}
    local normalList = {}
    self.EggMapping = {}

    local renderedFolder = Workspace:FindFirstChild("RenderedEggs")

    if ActiveEggs then
        for i, eggNode in ipairs(ActiveEggs:GetChildren()) do
            -- Abaikan jika telur milik private orang lain
            local privateTo = eggNode:GetAttribute("PrivateTo")

            if not privateTo or privateTo == LocalPlayer.UserId then
                local eggName = eggNode:GetAttribute("Egg") or eggNode.Name
                local model = renderedFolder and renderedFolder:FindFirstChild(eggName)
                local luckStatus = getEggLuck(model)
                local label = string.format("%s (luck %s) [%d]", eggName, luckStatus, i)

                self.EggMapping[label] = {
                    Node = eggNode,       -- Objek data untuk remote
                    EggName = eggName,
                    Position = eggNode:GetAttribute("Position")
                }
                if isHighTier(luckStatus) then
                    table.insert(opList, label)
                else
                    table.insert(normalList, label)
                end
            end
        end
    end

    if #opList == 0 then table.insert(opList, "Tidak ada telur OP") end
    if #normalList == 0 then table.insert(normalList, "Tidak ada telur biasa") end
    return opList, normalList
end

