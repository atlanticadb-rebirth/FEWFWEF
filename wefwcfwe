_G.SelectedTeleportTarget = nil
local LocalPlayer = Players.LocalPlayer

-- === ⚡ ENGINE TELEPORTASI INSTAN (AMBILS NAMA STRINGS) ===
local function teleportToSelectedPlayer()
    if not _G.SelectedTeleportTarget or _G.SelectedTeleportTarget == "" then
        task.spawn(function()
            Library:Notify({ Title = "Notify", Description = "Select player in dropdown", Time = 3 })
        end)
        return
    end

    -- Sekarang _G.SelectedTeleportTarget sudah pasti berupa String nama asli
    local targetPlayer = Players:FindFirstChild(_G.SelectedTeleportTarget)
    local targetChar = targetPlayer and targetPlayer.Character
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if myRoot and targetRoot then
        pcall(function()
            -- 🧲 Pengaman fisik agar tidak memicu deteksi anti-cheat jatuh bebas
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            myRoot.Anchored = true
            if myHumanoid then myHumanoid:ChangeState(Enum.HumanoidStateType.Physics) end

            -- Berkedip tepat 3.5 stud di atas kepala target player
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 3.5, 0)
            task.wait(0.15) -- Jeda mikro sinkronisasi koordinat server

            myRoot.Anchored = false
            if myHumanoid then myHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)

        task.spawn(function()
            Library:Notify({ Title = "Notify", Description = "Target to " .. targetPlayer.Name, Time = 2 })
        end)
    else
        task.spawn(function()
            Library:Notify({ Title = "Notify", Description = "Character nil", Time = 3 })
        end)
    end
end

