-- // Helper Baru: Berjalan Kaki ke batas luar Hitbox -> Tunggu Timer -> Jalan Masuk
function utility:FlyTo(targetPos)
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChild("Humanoid")
    if not rootPart or not humanoid then return end



    -- Mencari data Hitbox dari Plot milik kita
    local myPlot = self:GetMyPlot()
    local waitPos = targetPos + Vector3.new(20, 0, 0)

    if myPlot then
        local fence = myPlot:FindFirstChild("Fence")
        local hitbox = fence and fence:FindFirstChild("Hitbox")
        if hitbox then
           -- Batas aman dihitung otomatis dari ukuran pagar
            local batasAmanX = (hitbox.Size.X / 2) + 10
            waitPos = hitbox.Position + Vector3.new(batasAmanX, 0, 0)
            waitPos = Vector3.new(waitPos.X, targetPos.Y, waitPos.Z)
        end
    end

    -- TAHAP 1: BERJALAN CEPAT KE LUAR HITBOX PLOT
    -- Kita manfaatkan slider "FlySpeed" di UI sebagai pengatur kecepatan lari
    humanoid.WalkSpeed = self.FlySpeed

    -- Loop berjalan agar tidak terkena limit timeout 8 detik dari Roblox
    while (rootPart.Position * Vector3.new(1,0,1) - waitPos * Vector3.new(1,0,1)).Magnitude > 2 do

        humanoid:MoveTo(waitPos)

        task.wait(0.1)

    end

    -- Rem karakter agar benar-benar diam di luar plot
    humanoid.WalkSpeed = 0
    rootPart.Velocity = Vector3.new(0, 0, 0)
    -- TAHAP 2: MENUNGGU TIMER UI

    print("[AutoFarm] Berhasil jalan ke batas luar. Menunggu Timer...")
    local maxWait = 20
    local waited = 0

    while waited < maxWait do
        local isReady = false
        pcall(function()
            local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if PlayerGui then
                local eggUI = PlayerGui:FindFirstChild("EggBreaking")
                if eggUI and eggUI:FindFirstChild("EggBreaking") then
                    local breakTime = eggUI.EggBreaking:FindFirstChild("BreakTime")
                    local timerLbl = breakTime and breakTime:FindFirstChild("Timer")                

                    if timerLbl and timerLbl:IsA("TextLabel") then
                        local txt = timerLbl.Text
                        local sec = nil

                        if string.find(txt, ":") then
                            sec = tonumber(string.match(txt, ":(%d+)"))
                        else
                            sec = tonumber(string.match(txt, "%d+"))
                        end
                        -- Masuk plot ketika sisa waktu 2 sampai 4 detik
                        if sec and sec >= 2 and sec <= 4 then

                            isReady = true
                        end
                    end
                end
            end
        end)

        if isReady then
            print("[AutoFarm] Timer cocok! Karakter mulai berjalan masuk.")
            break
        end
        task.wait(0.2)
        waited = waited + 0.2
    end

    -- TAHAP 3: JALAN KAKI MASUK AREA PLOT DENGAN KECEPATAN NORMAL

    humanoid.WalkSpeed = 16

    while (rootPart.Position * Vector3.new(1,0,1) - targetPos * Vector3.new(1,0,1)).Magnitude > 2 do
        humanoid:MoveTo(targetPos)
        task.wait(0.1)
    end
    print("[AutoFarm] Berhasil mengantar telur ke plot!")
end

-- // Core Logic: Ambil Instan dengan Deteksi Waktu Server
function utility:StealEgg(targetData)
	local char = LocalPlayer.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	local myPlot = self:GetMyPlot()
	
	if not rootPart or not targetData then return end
	
	-- 1. Deteksi Posisi Asli
	local targetPos = targetData.Position
	if not targetPos then
		local renderedFolder = Workspace:FindFirstChild("RenderedEggs")
		local model = renderedFolder and renderedFolder:FindFirstChild(targetData.EggName)
		if model then targetPos = model:GetPivot().Position end
	end
	
	if targetPos then
		print("[AutoFarm] Teleport ke telur:", targetData.EggName)
		
		-- 2. Teleport menempel ke tanah (jangan pakai +3 di udara)
		rootPart.Velocity = Vector3.new(0, 0, 0)
		rootPart.CFrame = CFrame.new(targetPos)
		
		-- 3. BYPASS: Tunggu DropEndsAt server selesai
		if targetData.Node then
			local dropEndsAt = tonumber(targetData.Node:GetAttribute("DropEndsAt")) or 0
			local serverTime = workspace:GetServerTimeNow()
			
			if dropEndsAt > serverTime then
				local waitTime = dropEndsAt - serverTime
				print(string.format("[AutoFarm] Telur sedang jatuh. Menunggu %.1f detik...", waitTime))
				task.wait(waitTime + 0.2) -- Tambah 0.2 detik agar sinkron dengan server
			else
				task.wait(0.5) -- Jeda aman biasa jika telur sudah lama spawn
			end
		end
		
		-- 4. Fire Remote Persis Seperti Klien Asli
		if targetData.Node and targetData.Node.Parent then
			EggPickupRemote:FireServer(targetData.Node.Name)
			print("[Pickup] Mengeksekusi remote pengambilan!")
		end
		task.wait(0.5)
		-- 5. Terbang ke Plot dengan Slow Motion
		if myPlot then
			print("[AutoFarm] OTW bawa telur ke Plot...")
			local plotTarget = (myPlot:GetPivot() * CFrame.new(0, 5, 0)).Position
			self:FlyTo(plotTarget)
			task.wait(1.5) 
		end
	end
end


