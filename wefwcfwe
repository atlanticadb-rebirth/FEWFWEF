local function startObserver()
    local list = getPlayerList()
    if #list == 0 then
        Library:Notify({ Title = "Notify", Description = "Player nil", Time = 4 })
        return
    end

    ObsState.Active = true
    ObsState.Camera = workspace.CurrentCamera

    local function observeTarget()
        local target = getCurrentTarget()
        if not target then
            Library:Notify({ Title = "Notify", Description = "Player nil", Time = 4 })
            stopObserver()
            Toggles.ObserverMode:SetValue(false)
            return
        end

        -- Update camera subject ke humanoid target
        local char = target.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if humanoid then
            ObsState.Camera.CameraType = Enum.CameraType.Custom
            ObsState.Camera.CameraSubject = humanoid
        elseif hrp then
            ObsState.Camera.CameraType = Enum.CameraType.Attach
            ObsState.Camera.CameraSubject = hrp
        end

        -- Update GUI
        local list2 = getPlayerList()
        local sg, prevBtn, nextBtn, nameLabel = createObsGui(target.Name, ObsState.CurrentIndex, #list2)

        -- Disconnect connection lama kalau ada
        if ObsState.BtnConn1 then ObsState.BtnConn1:Disconnect() end
        if ObsState.BtnConn2 then ObsState.BtnConn2:Disconnect() end

        ObsState.BtnConn1 = prevBtn.MouseButton1Click:Connect(function()
            local l = getPlayerList()
            if #l == 0 then return end
            ObsState.CurrentIndex = ObsState.CurrentIndex - 1
            if ObsState.CurrentIndex < 1 then ObsState.CurrentIndex = #l end
            observeTarget()
        end)

        ObsState.BtnConn2 = nextBtn.MouseButton1Click:Connect(function()
            local l = getPlayerList()
            if #l == 0 then return end
            ObsState.CurrentIndex = ObsState.CurrentIndex + 1
            if ObsState.CurrentIndex > #l then ObsState.CurrentIndex = 1 end
            observeTarget()
        end)

        -- Auto update kalau target respawn
        if ObsState.Connection then ObsState.Connection:Disconnect() end
        ObsState.Connection = target.CharacterAdded:Connect(function()
            task.wait(0.5)
            if ObsState.Active then observeTarget() end
        end)
    end

    observeTarget()
    --notify("Observer", "Observing: " .. (getCurrentTarget() and getCurrentTarget().Name or "?"), "eye")
end

